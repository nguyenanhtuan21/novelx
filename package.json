{
  "name": "novelx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm --workspace @novelx/api run start:dev",
    "dev:web": "npm --workspace @novelx/web run dev",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "smoke": "npm run smoke --workspaces --if-present",
    "test": "npm run test:ts && npm run test:ai",
    "test:ai": "npm --workspace @novelx/ai-factory run test",
    "test:e2e": "playwright test",
    "test:ts": "npm --workspace @novelx/shared run test && npm --workspace @novelx/api run test && npm --workspace @novelx/web run test",
    "typecheck": "tsc -b",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run smoke && npm run build && npm audit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "eslint": "^10.8.0",
    "prettier": "^3.7.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.50.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
